<%- include("partials/head", { title: "Service Entry" }) %>

    <body>
        <%- include("partials/navbar") %>
            <main class="container py-4 fellow-page-content">
                <div class="page-card bg-white rounded shadow-sm p-4">
                    <h1 class="h3 mb-4">Add Service Entry</h1>

                    <form method="POST" action="/service-entry">

                        <div class="mb-3">
                            <label for="service_type" class="form-label">Service type
                                <button type="button" class="btn btn-primary info-btn " data-bs-toggle="popover"
                                    data-bs-html="true"
                                    data-bs-content="<p>Choose <strong>Primary site </strong>for regular service at your assigned site.</p><p>Choose <strong>One-time opportunity</strong> if you completed service at a different site.</p>"><i
                                        class="bi bi-info-lg"></i></button>
                            </label>

                            <select id="service_type" name="service_type" class="form-select" required>
                                <option value=""> Choose a service type</option>
                                <option value="regular">Primary site</option>
                                <option value="one_time">One-time opportunity</option>
                            </select>
                        </div>

                        <!-- Primary site section -->
                        <div id="primary_site_section">
                            <div class="mb-3">
                                <label class="form-label">Your primary site</label>

                                <div class="alert alert-info">
                                    <% if (primarySiteName) { %>
                                        <%= primarySiteName %>
                                            <% } else { %>
                                                No primary site has been assigned.
                                                <% } %>
                                </div>

                                <input type="hidden" id="site_id" name="site_id" value="<%= primarySiteId || '' %>">
                            </div>
                        </div>

                        <!-- One-time section -->
                        <div id="one_time_section" class="d-none">
                            <div class="mb-3">
                                <label for="one_time_site_choice" class="form-label">Choose a site <button type="button"
                                        class="btn btn-primary info-btn " data-bs-toggle="popover" data-bs-html="true"
                                        data-bs-content="Guide: <ul><li><strong>Add new site: </strong>Choose this option if you don't see your site name in the list</li> <li><strong>Existing one-time sites: </strong>These are the already available one-time sites.</li><li><strong>Primary sites: </strong>If you see your site name select that options please.</li></ul>"><i class="bi bi-info-lg"></i></button></label>
                                <select id="one_time_site_choice" name="one_time_site_choice" class="form-select">
                                    <option value=""></option>
                                    <option value="new">Add a new site</option>
                                    <optgroup label="Existing one-time sites">
                                        <% oneTimeSites.forEach(function (site) { %>
                                            <option value="temporary_<%= site.id %>">
                                                <%= site.name %>
                                            </option>
                                            <% }); %>
                                    </optgroup>
                                    <optgroup label="Primary sites">
                                        <% sites.forEach(function (site) { %>
                                            <option value="official_<%= site.id %>">
                                                <%= site.name %>
                                            </option>
                                            <% }); %>
                                    </optgroup>
                                </select>
                            </div>

                            <div id="new_site_section" class="mb-3 d-none">
                                <label for="new_one_time_site_name" class="form-label">New site name</label>
                                <input id="new_one_time_site_name" name="new_one_time_site_name" type="text"
                                    class="form-control">
                            </div>
                        </div>

                        <div class="mb-3">
                            <label for="service_date" class="form-label">Service date <button type="button"
                                    class="btn btn-primary info-btn " data-bs-toggle="popover" data-bs-html="true"
                                    data-bs-content="Choose a date to log your hours. <p>If you have worked at different sites on same date you can add more than one entry for the same date.</p>"><i
                                        class="bi bi-info-lg"></i></button>
                            </label>
                            <input id="service_date" name="service_date" type="date" class="form-control" required>
                        </div>

                        <div class="mb-3">
                            <label for="hours" class="form-label">Total service hours, excluding breaks. <button
                                    type="button" class="btn btn-primary info-btn " data-bs-toggle="popover"
                                    data-bs-html="true" data-bs-content="If you work on more than five hours you have to add 30 minutes of break so please exclude that when you are adding"><i
                                        class="bi bi-info-lg"></i></button></label>
                            <input id="hours" name="hours" type="number" min="0" step="0.25" class="form-control"
                                required>
                        </div>

                        <div class="mb-3">
                            <label for="service_description" class="form-label">Please provide a brief description of
                                your service at the site. <button type="button" class="btn btn-primary info-btn "
                                    data-bs-toggle="popover" data-bs-html="true" data-bs-content="Example ......."><i
                                        class="bi bi-info-lg"></i></button> </label>
                            <textarea id="service_description" name="service_description" class="form-control" rows="3"
                                required></textarea>
                        </div>

                        <div class="mb-3">
                            <label for="people_helped" class="form-label">Number of people supported <button type="button" class="btn btn-primary info-btn " data-bs-toggle="popover"
                                    data-bs-html="true" data-bs-content="Example ......."><i
                                        class="bi bi-info-lg"></i></button></label>
                            <input id="people_helped" name="people_helped" type="number" min="0" class="form-control"
                                required>
                        </div>

                        <div class="mb-3">
                            <label for="concerns" class="form-label">Any concerns about your service site? (Optional)
                                <button type="button" class="btn btn-primary info-btn " data-bs-toggle="popover"
                                    data-bs-html="true" data-bs-content="Example ......."><i
                                        class="bi bi-info-lg"></i></button> </label>
                            <textarea id="concerns" name="concerns" class="form-control" rows="3"></textarea>
                        </div>
                        <div id="questions_section" class="mt-4 d-none">
                            <h5>Additional Questions <button type="button" class="btn btn-primary info-btn "
                                    data-bs-toggle="popover" data-bs-html="true" data-bs-content="Example ......."><i
                                        class="bi bi-info-lg"></i></button> </h5>
                            <div id="questions_container"></div>
                        </div>
                        <button type="submit" class="btn btn-primary">Submit</button>
                    </form>
                </div>
            </main>
            <script src="/js/service_entry.js"></script>
    </body>

    </html>