<%- include("partials/head", { title: "Login" }) %>

    <body>
        <main class="login-page d-flex align-items-center justify-content-center">
            <div class="card login-card border-0 shadow-lg overflow-hidden">
                <div class="row g-0">
                    <div class="col-md-5">
                        <img src="/images/login_back.jpg" class="login-image" alt="College Corps">
                    </div>

                    <div class="col-md-7">
                        <div class="card-body p-4 p-lg-5">

                            <img src="/images/college_corps_logo.png" alt="College Corps Logo" class="logo-img mb-4">
                            <h3 class="mb-2 text-center">Welcome Back!</h3>
                            <p class="text-muted mb-4 text-center">Log in to your account.</p>

                            <% if (error) { %>
                                <div class="alert alert-danger">
                                    <%= error %>
                                </div>
                                <% } %>

                                    <form method="POST" action="/login">
                                        <div class="mb-3">
                                            <label for="email" class="form-label">Email</label>
                                            <input id="email" name="email" type="email" class="form-control"
                                                autocomplete="email" required>
                                        </div>

                                        <div class="mb-3">
                                            <label for="password" class="form-label">Password</label>
                                            <input id="password" name="password" type="password" class="form-control"
                                                autocomplete="current-password" required>
                                        </div>
                                        <!-- need to work on this -->
                                        <a href="#">Forgot Password?</a> 
                                        <br>
                                        <br>
                                        <button type="submit" class="btn login-btn ">Log in</button>
                                    </form>

                        </div>
                    </div>

                </div>
            </div>
        </main>
    </body>

    </html>